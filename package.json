{
  "name": "@rahul_dadhich15/css-toolkit",
  "version": "0.1.0",
  "description": "Production-ready CSS toolkit providing reusable generators, color utilities, formatters, layout generators, selector analysis, conversions, SCSS compilation, and Tailwind integration.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./scss": {
      "types": "./dist/scss.d.ts",
      "import": "./dist/scss.js",
      "require": "./dist/scss.cjs"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "import": "./dist/tailwind.js",
      "require": "./dist/tailwind.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('coverage', { recursive: true, force: true });\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "css",
    "css-toolkit",
    "css-generator",
    "color-converter",
    "tailwind",
    "scss",
    "sass",
    "flexbox",
    "grid",
    "specificity",
    "beautify",
    "minify",
    "react-native",
    "keyframes"
  ],
  "author": "Rahul Dadhich",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahuldadhich1517-sys/css-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/rahuldadhich1517-sys/css-toolkit/issues"
  },
  "homepage": "https://github.com/rahuldadhich1517-sys/css-toolkit#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "postcss": "^8.5.3",
    "postcss-selector-parser": "^7.1.0",
    "sass": "^1.85.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
